// Prisma schema for the school management app.
// Prisma 7: datasource URL lives in prisma7.config.ts, client output is source
// (TypeScript) and is gitignored — regenerate with `pnpm db:generate`.
//
// Data-model conventions:
// - Every table has a cuid primary key plus `createdAt` / `updatedAt`.
// - Domain models map to snake_case table names.
// - Lookup/managed sets (rooms, levels, sessions) are their own tables.
// - Teachers are `User` rows with `role = "teacher"` (no separate table).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Better Auth core tables
// Field names/types mirror the Better Auth schema exactly (see AGENTS.md).
// ---------------------------------------------------------------------------

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  // Application role: "manager" | "teacher". Managed out-of-band (not via signup).
  role          String   @default("teacher")
  // Forces a password change on next sign-in (set when a manager resets it).
  mustChangePassword Boolean @default(false)
  // Contact details (teachers are users with role = "teacher").
  phone         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions        Session[]
  accounts        Account[]
  taughtClasses   SchoolClass[]    @relation("ClassTeacher")
  studentComments StudentComment[]
  guardianComments GuardianComment[]
  classComments   ClassComment[]
  recordedAttendance Attendance[]  @relation("AttendanceRecorder")
  recordedExams   Exam[]           @relation("ExamRecorder")
  recordedGrades  Grade[]          @relation("GradeRecorder")
  recordedDonations StudentDonation[] @relation("DonationRecorder")
  recordedPeriodReportObservations PeriodReportObservation[] @relation("PeriodReportObservationRecorder")
  recordedYearReportObservations   YearReportObservation[]   @relation("YearReportObservationRecorder")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// ---------------------------------------------------------------------------
// School domain models
// ---------------------------------------------------------------------------

enum Sex {
  MALE
  FEMALE
}

// A student. Guardians are linked many-to-many through StudentGuardian;
// classes through Enrollment; comments through StudentComment.
model Student {
  id          String   @id @default(cuid())
  firstName   String
  lastName    String
  sex         Sex?
  dateOfBirth DateTime
  image       String? // URL path under /uploads/students
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  guardians   StudentGuardian[]
  enrollments Enrollment[]
  comments    StudentComment[]
  attendance  Attendance[]
  grades      Grade[]
  donations   StudentDonation[]
  periodReportObservations PeriodReportObservation[]
  yearReportObservations   YearReportObservation[]

  @@index([lastName, firstName])
  @@map("students")
}

// A guardian (parent/carer). Can be responsible for several students.
// `donationNumber` and `educationNumber` are optional, unique identifiers from
// the subscription (Google) form — unique only when present (Postgres allows
// many NULLs), so they can be used to look a family up.
model Guardian {
  id              String   @id @default(cuid())
  firstName       String
  lastName        String
  email           String?
  phone           String?
  address         String?
  donationNumber  String?  @unique
  educationNumber String?  @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  children StudentGuardian[]
  comments GuardianComment[]

  @@index([lastName, firstName])
  @@map("guardians")
}

// Join table: student <-> guardian. `relation` describes the link itself
// (a guardian may be "mother" to one child and "aunt" to another).
model StudentGuardian {
  id         String   @id @default(cuid())
  studentId  String
  guardianId String
  // e.g. "mother", "father", "grandmother", "other"
  relation   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@unique([studentId, guardianId])
  @@index([guardianId])
  @@map("student_guardians")
}

// Managed set of classrooms.
model Room {
  id          String   @id @default(cuid())
  name        String   @unique
  capacity    Int?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  classes SchoolClass[]

  @@map("rooms")
}

// Managed set of levels (e.g. "Group 1", "Beginners").
model Level {
  id        String   @id @default(cuid())
  name      String   @unique
  sortOrder Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classes  SchoolClass[]
  subjects Subject[]

  @@map("levels")
}

// Managed set of sessions. This is a weekend school: 3 sessions per day
// (morning, noon, afternoon) on Saturday and Sunday => 6 possible sessions.
// A class runs during one or more sessions (see SchoolClassSession).
// Times are stored as "HH:mm" strings; `day` and the times are what the UI
// labels a timeslot with (e.g. "Zaterdag 09:00–12:00").
model ClassSession {
  id        String   @id @default(cuid())
  label     String   @unique // e.g. "Zaterdag ochtend"
  day       String? // e.g. "Zaterdag"
  startTime String? // "HH:mm"
  endTime   String? // "HH:mm"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classes    SchoolClassSession[]
  attendance Attendance[]

  @@map("class_sessions")
}

model SchoolClass {
  id          String   @id @default(cuid())
  name        String
  description String?
  levelId     String
  roomId      String?
  teacherId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  level       Level               @relation(fields: [levelId], references: [id], onDelete: Restrict)
  room        Room?               @relation(fields: [roomId], references: [id], onDelete: SetNull)
  teacher     User?               @relation("ClassTeacher", fields: [teacherId], references: [id], onDelete: SetNull)
  sessions    SchoolClassSession[]
  enrollments Enrollment[]
  comments    ClassComment[]
  attendance  Attendance[]
  exams       Exam[]

  @@index([teacherId])
  @@index([levelId])
  @@index([roomId])
  @@map("classes")
}

// Join table: class <-> session (a class can run in multiple sessions).
model SchoolClassSession {
  id        String   @id @default(cuid())
  classId   String
  sessionId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  class   SchoolClass  @relation(fields: [classId], references: [id], onDelete: Cascade)
  session ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([classId, sessionId])
  @@index([sessionId])
  @@map("class_session_links")
}

// Join table: student <-> class with enrollment dates and status.
model Enrollment {
  id        String    @id @default(cuid())
  studentId String
  classId   String
  startDate DateTime  @default(now())
  endDate   DateTime?
  // "active" | "withdrawn"
  status    String    @default("active")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  student Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class   SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([studentId, classId])
  @@index([classId])
  @@map("enrollments")
}

// ---------------------------------------------------------------------------
// Comments — one table per commented entity (normalized, real FKs).
// `author` is the staff member (manager/teacher) who wrote the comment.
// ---------------------------------------------------------------------------

model StudentComment {
  id        String   @id @default(cuid())
  studentId String
  authorId  String?
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  author  User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([studentId])
  @@index([authorId])
  @@map("student_comments")
}

model GuardianComment {
  id         String   @id @default(cuid())
  guardianId String
  authorId   String?
  body       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  guardian Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  author   User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([guardianId])
  @@index([authorId])
  @@map("guardian_comments")
}

model ClassComment {
  id        String   @id @default(cuid())
  classId   String
  authorId  String?
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  class  SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  author User?       @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([classId])
  @@index([authorId])
  @@map("class_comments")
}

// ---------------------------------------------------------------------------
// Attendance — presence per student, per class, per session slot, per date.
// One row = one student's status at one class meeting. The unique key makes
// marking idempotent (re-saving the roster upserts instead of duplicating).
// ---------------------------------------------------------------------------

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  VERY_LATE
  EXCUSED
}

model Attendance {
  id           String           @id @default(cuid())
  studentId    String
  classId      String
  sessionId    String // ClassSession (weekend slot), not an auth Session
  date         DateTime         @db.Date
  status       AttendanceStatus
  note         String?
  recordedById String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  student    Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class      SchoolClass  @relation(fields: [classId], references: [id], onDelete: Cascade)
  // Restrict: attendance is history — deleting a lookup slot must not silently
  // wipe records (unlike SchoolClassSession, which cascades).
  session    ClassSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  recordedBy User?        @relation("AttendanceRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  @@unique([studentId, classId, sessionId, date])
  @@index([classId, sessionId, date])
  @@index([studentId])
  @@index([recordedById])
  @@map("attendance")
}

// ---------------------------------------------------------------------------
// Academic years, terms (periods), subjects, exams and grades.
//
// - `Term` (UI: "Periode") is a **global** definition (name, order, month
//   range) applied to every academic year — not owned by a year. The model is
//   called `Term` to avoid colliding with `ClassSession` (weekend timeslot).
// - `Subject` is scoped to a `Level` (e.g. "Math" exists once per level); the
//   level of an exam therefore comes from the class.
// - An `Exam` is one test for one class + subject + period + academic year. A
//   teacher can add several exams per subject per period, each with a free
//   `title` (e.g. "Hoofdstuk 1"). `coefficient` weights the exam when averaging
//   a subject over the period.
// - A `Grade` is one student's score on one exam (integers 1-10; `null` means
//   "not graded yet"). Averages/ranks are never stored — reports compute them
//   on read.
// ---------------------------------------------------------------------------

model AcademicYear {
  id        String    @id @default(cuid())
  name      String    @unique // e.g. "2026-2027"
  startDate DateTime? @db.Date
  endDate   DateTime? @db.Date
  // At most one current year; enforced in the Server Action, not the DB.
  isCurrent Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  exams     Exam[]
  donations StudentDonation[]
  periodReportObservations PeriodReportObservation[]
  yearReportObservations   YearReportObservation[]

  @@map("academic_years")
}

// A period ("Periode"/"Termijn") defined once and applied to every academic
// year. The UI says "Periode". It is scoped by two month numbers (1-12) that do
// not cross the calendar-year boundary; concrete dates are derived per academic
// year (`startMonth` first day → `endMonth` last day). Exams are what tie a
// period to a specific year (see `Exam.academicYearId`).
model Term {
  id         String   @id @default(cuid())
  name       String   @unique // e.g. "Termijn 1"
  sortOrder  Int      @unique
  startMonth Int // 1-12
  endMonth   Int // 1-12, >= startMonth
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  exams Exam[]
  periodReportObservations PeriodReportObservation[]

  @@map("terms")
}

model Subject {
  id          String   @id @default(cuid())
  levelId     String
  name        String // clean name ("Math"); the level is the relation below
  description String?
  image       String? // URL path under /uploads/subjects
  sortOrder   Int?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  level Level  @relation(fields: [levelId], references: [id], onDelete: Restrict)
  exams Exam[]

  @@unique([levelId, name])
  @@index([levelId])
  @@map("subjects")
}

model Exam {
  id             String   @id @default(cuid())
  classId        String
  subjectId      String
  termId         String
  // Terms are global; the year is what scopes an exam to a school year.
  academicYearId String
  // Free label chosen by the teacher, e.g. "Hoofdstuk 1".
  title          String
  date           DateTime @db.Date
  // Weight of this exam in the subject's period average (>= 1).
  coefficient    Int      @default(1)
  recordedById   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  class SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  // Restrict: exams/grades are history — deleting a subject/term/year must not
  // wipe them.
  subject      Subject      @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  term         Term         @relation(fields: [termId], references: [id], onDelete: Restrict)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  recordedBy   User?        @relation("ExamRecorder", fields: [recordedById], references: [id], onDelete: SetNull)
  grades       Grade[]

  @@index([classId, termId, subjectId])
  @@index([classId, academicYearId])
  @@index([subjectId])
  @@index([termId])
  @@index([academicYearId])
  @@index([recordedById])
  @@map("exams")
}

model Grade {
  id           String   @id @default(cuid())
  studentId    String
  examId       String
  score        Int? // 1-10; null = not graded
  remark       String?
  recordedById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  student    Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  exam       Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  recordedBy User?   @relation("GradeRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  @@unique([studentId, examId])
  @@index([examId])
  @@index([studentId])
  @@index([recordedById])
  @@map("grades")
}

// ---------------------------------------------------------------------------
// Report observations — a free text the teacher leaves for a student on a report.
// - `PeriodReportObservation` is one observation per student per period (Term)
//   in a year.
// - `YearReportObservation` is one observation per student per year report.
// Observations show on the on-screen report and on the printed A4 report.
// ---------------------------------------------------------------------------

model PeriodReportObservation {
  id             String   @id @default(cuid())
  studentId      String
  termId         String
  academicYearId String
  body           String
  recordedById   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  term         Term         @relation(fields: [termId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  recordedBy   User?        @relation("PeriodReportObservationRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  @@unique([studentId, termId, academicYearId])
  @@index([termId])
  @@index([academicYearId])
  @@index([recordedById])
  @@map("period_report_observations")
}

model YearReportObservation {
  id             String   @id @default(cuid())
  studentId      String
  academicYearId String
  body           String
  recordedById   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  recordedBy   User?        @relation("YearReportObservationRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  @@unique([studentId, academicYearId])
  @@index([academicYearId])
  @@index([recordedById])
  @@map("year_report_observations")
}

// ---------------------------------------------------------------------------
// Donations — guardians pay a yearly donation per student.
//
// - `DonationSetting` is a singleton holding the global default amount.
// - `StudentDonation` is one row per student per year: the expected amount
//   (defaults from the setting, overridable — some families pay less or
//   nothing) and the single manually-updated paid amount.
// - Balance/status are derived on read: balance = expected - paid.
// ---------------------------------------------------------------------------

enum DonationCategory {
  FULL
  REDUCED
  EXEMPT
}

model DonationSetting {
  id            String   @id @default("default")
  defaultAmount Decimal  @db.Decimal(10, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("donation_settings")
}

model StudentDonation {
  id             String           @id @default(cuid())
  studentId      String
  academicYearId String
  // Expected amount for this student this year (0 when exempt).
  expectedAmount Decimal          @db.Decimal(10, 2)
  // Single paid value (partial/over allowed); balance = expected - paid.
  paidAmount     Decimal          @default(0) @db.Decimal(10, 2)
  category       DonationCategory @default(FULL)
  paidAt         DateTime?        @db.Date
  note           String?
  recordedById   String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  // Restrict: financial history — a year with donations cannot be deleted.
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  recordedBy   User?        @relation("DonationRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  @@unique([studentId, academicYearId])
  @@index([academicYearId])
  @@index([recordedById])
  @@map("student_donations")
}
