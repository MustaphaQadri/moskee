# Copy this file to /srv/moskee/.env on the server and fill in real values.
# Generate secrets with: openssl rand -base64 32  /  openssl rand -hex 24

# --- Public address / TLS ---------------------------------------------------
# Plain HTTP on the IP (no certificate):
SITE_ADDRESS=http://194.163.164.250
BETTER_AUTH_URL=http://194.163.164.250
#
# After a domain's A/AAAA record points to 194.163.164.250, switch to HTTPS by
# changing these two lines and running `docker compose up -d`:
#   SITE_ADDRESS=app.example.com
#   BETTER_AUTH_URL=https://app.example.com

# --- Database (the `db` container) -----------------------------------------
POSTGRES_USER=moskee
POSTGRES_PASSWORD=change-me
POSTGRES_DB=moskee
DATABASE_URL=postgresql://moskee:change-me@db:5432/moskee?schema=public

# --- Better Auth ------------------------------------------------------------
BETTER_AUTH_SECRET=change-me

# --- First manager account (used only by `pnpm db:seed`) --------------------
SEED_MANAGER_EMAIL=manager@moskee.local
SEED_MANAGER_PASSWORD=change-me-123
